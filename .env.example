# =====================================================================
# Free AI APIs Configuration (from OuterSpacee/free-ai-apis)
# No Credit Card Required — Build AI Takeoff at ₹0 Cost
# =====================================================================

# 1. Google AI Studio (Gemini 2.5 Flash / 1.5 Flash - 1,500 req/day FREE)
# Get your free key instantly at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Ultra-fast Llama 3.3 / Llama 3.1 - 1,000 req/day FREE)
# Get your free key instantly at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# 3. Hugging Face (500k+ models - Serverless Inference FREE)
# Get your free token at: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# 4. OpenRouter (Free community models)
# Get your free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 5. Local Offline LLM (Ollama - 100% Free & Unlimited)
# Run `ollama run llama3.2` locally (no API key needed)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
